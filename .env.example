DATABASE_URL=postgresql://barter:barter_local_password@localhost:5432/barter
JWT_SECRET=replace-with-a-local-development-secret
WECHAT_APP_ID=replace-with-your-wechat-app-id
WECHAT_APP_SECRET=replace-with-your-wechat-app-secret
ADMIN_SEED_PASSWORD=replace-with-a-local-admin-password
E2E_REVIEWER_PASSWORD=
CORS_ORIGINS=http://localhost:10086
LOCAL_IMAGE_STORAGE_DIR=.local/item-images
IMAGE_PUBLIC_BASE_URL=http://localhost:3000/api/uploads/item-images/files
WECHAT_IDENTITY_PROVIDER=wechat

# Required only for private order shipping details; use a random 32-byte key.
ADDRESS_ENCRYPTION_KEY_BASE64=replace-with-base64-encoded-32-byte-key
ADDRESS_ENCRYPTION_KEY_VERSION=replace-with-key-version

# Disabled capabilities return 503. Explicit simulated is only for development/test.
PAYMENT_PROVIDER=disabled
LOGISTICS_PROVIDER=disabled
# Generate a random 32-byte key for the API only; never bundle it in a frontend.
# Reuse the same runtime test key across API restarts while reconciling simulated facts.
# The own-payment completion route exists only in development/test + simulated payment.
# Checkout uses an authenticated no-store GET; no real money is produced by simulation.
SIMULATED_INTEGRATION_SIGNING_KEY_BASE64=replace-with-base64-encoded-32-byte-key
