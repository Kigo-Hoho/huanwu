{
  "name": "@barter/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "npm run build --workspace @barter/contracts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "predb:seed": "npm run db:generate",
    "db:seed": "prisma db seed",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint src test prisma prisma.config.ts vitest.config.ts",
    "pretest": "npm run build --workspace @barter/contracts",
    "start": "node dist/src/main.js",
    "test": "vitest run",
    "pretypecheck": "npm run build --workspace @barter/contracts",
    "typecheck": "prisma generate && tsc --noEmit"
  },
  "dependencies": {
    "@barter/contracts": "0.0.0",
    "@nestjs/common": "^12.0.4",
    "@nestjs/core": "^12.0.4",
    "@nestjs/platform-express": "^12.0.4",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "dotenv": "^17.2.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^12.0.4",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.11.0",
    "prisma": "^7.10.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.0.4"
  }
}
