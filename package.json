{
  "name": "barter-platform",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "node --test scripts/check-workspaces.test.mjs && npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "node --check scripts/check-workspaces.mjs && node --check scripts/check-workspaces.test.mjs",
    "build": "npm run build --workspaces --if-present",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  }
}
